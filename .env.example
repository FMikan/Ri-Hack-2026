# Copy to .env (git-ignored) and adjust. Read by docker compose AND by the backend on startup.
# Local development values only: never put real secrets here.

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-local-only
# Host port for the PostgreSQL container. Use another port (e.g. 5433) if 5432 is already taken.
POSTGRES_PORT=5432

# Used by the backend running on the host, so the host is localhost, not the compose service name.
# Keep it in sync with the POSTGRES_* values above.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=app;Username=app;Password=change-me-local-only

# Signs login tokens. At least 32 characters. Generate with: openssl rand -hex 32
Auth__JwtSigningKey=change-me-local-only-at-least-32-characters

# Sign in with Google (optional): the OAuth client id from Google Cloud Console, with http://localhost:5173 as an
# authorized JavaScript origin. Without it the Google button is hidden.
# Auth__GoogleClientId=1234567890-abc.apps.googleusercontent.com

# Password reset e-mails. Leave unset locally: the API prints the reset link in its log instead.
# Email__Smtp__Host=smtp.example.com
# Email__Smtp__Port=587
# Email__Smtp__Username=
# Email__Smtp__Password=
# Email__Smtp__From=

# Claude for explanations and lesson cards. Optional: without a key the game uses the static fallbacks.
# ANTHROPIC_API_KEY=
