# Server-side .env for deploy/docker-compose.prod.yml. Lives only on the server in ~/ri-hack-2026/.env.

POSTGRES_DB=app
POSTGRES_USER=app
# Generate with: openssl rand -hex 24   (hex only: it is embedded in a connection string)
POSTGRES_PASSWORD=

# A domain pointing at this server gets automatic HTTPS. Use :80 to serve plain HTTP by IP.
SITE_ADDRESS=example.com

# Only if another web server already owns 80/443 on this host, e.g.:
# HTTP_PORT=127.0.0.1:8081
# HTTPS_PORT=127.0.0.1:8443
