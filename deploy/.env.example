# Server-side .env for deploy/docker-compose.prod.yml. Lives only on the server in ~/ri-hack-2026/.env.

POSTGRES_DB=app
POSTGRES_USER=app
# Generate with: openssl rand -hex 24   (hex only: it is embedded in a connection string)
POSTGRES_PASSWORD=

# Signs login tokens. Generate with: openssl rand -hex 32
JWT_SIGNING_KEY=

# Password reset e-mails (optional). Without SMTP_HOST the reset link is only written to the api log.
# Port 587 with STARTTLS; SMTP_FROM defaults to SMTP_USERNAME.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Claude for explanations and lesson cards (optional; without it the game uses the static fallbacks).
ANTHROPIC_API_KEY=

# Port on 127.0.0.1 that the existing web server proxies to. Change it if 8081 is already taken.
WEB_PORT=8081
