# Serves the built frontend and proxies API traffic to the api container.
# SITE_ADDRESS: a domain (automatic HTTPS via Let's Encrypt) or ":80" for plain HTTP by IP.
{$SITE_ADDRESS::80} {
	encode

	@api path /api/* /health /health/*
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
