# Serves the built frontend and proxies API traffic to the api container.
# Plain HTTP: TLS is terminated by the server's existing web server in front of this container.
{
	servers {
		# Keep X-Forwarded-For/-Proto from the host's proxy (it reaches us from the Docker network), so the API
		# rate-limits by the player's IP instead of the proxy's.
		trusted_proxies static private_ranges
	}
}

:80 {
	encode

	@api path /api/* /health /health/*
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
