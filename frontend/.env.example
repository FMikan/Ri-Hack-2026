# Copy to .env.local (git-ignored) to override. Everything prefixed with VITE_ is PUBLIC: it ends up in the browser bundle.
# Full origin of the backend. The browser calls it directly; the backend must allow this app's origin via Cors:AllowedOrigins.
VITE_API_BASE_URL=http://localhost:5080

# true: fill the dashboard stats (rating history, mastery, level, streak, coins) with test numbers until the backend
# phases behind them exist. A "Demo data" badge shows in the top bar. Leave unset for real data only.
# VITE_DEMO_DATA=true
